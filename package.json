{
  "name": "sshkit",
  "private": true,
  "version": "0.1.0",
  "description": "Lean local-first SSH terminal client (feature-equivalent rebuild study of a commercial terminal, original implementation)",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "rebuild:pty": "electron-rebuild -f -w node-pty",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:e2e",
    "dist": "pnpm run build && electron-builder --mac --arm64 --publish never",
    "dist:dir": "pnpm run build && electron-builder --mac --arm64 --publish never --dir",
    "dist:dmg": "bash scripts/make-dmg.sh"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "keytar": "^7.9.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0"
  },
  "license": "MIT",
  "author": "suninx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suninx/sshkit.git"
  },
  "homepage": "https://github.com/suninx/sshkit#readme"
}